<ui:UXML xmlns:l="UnityEngine.Localization" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement name="shop-page" class="shop-page item-context-panel ui-panel-frame" picking-mode="Position">
    <ui:VisualElement class="item-context-header">
      <ui:Label text="" class="item-context-title">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="shop.title" />
        </Bindings>
      </ui:Label>
      <ui:Label text="" class="item-context-kicker">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="shop.kicker" />
        </Bindings>
      </ui:Label>
    </ui:VisualElement>
    <ui:Label name="shop-gold" text="" class="shop-gold" />
    <ui:VisualElement name="shop-merchant-frame" class="shop-merchant-frame">
      <ui:VisualElement name="shop-merchant-list" class="shop-merchant-grid" picking-mode="Position" />
      <ui:Label name="shop-merchant-empty" text="" class="shop-empty" picking-mode="Ignore">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="shop.merchant.empty" />
        </Bindings>
      </ui:Label>
    </ui:VisualElement>
    <ui:Foldout name="shop-source-toggle" class="item-source-section" value="true">
      <Bindings>
        <l:LocalizedString property="text" table="ui" entry="window.sell_source" />
      </Bindings>
      <ui:ScrollView name="shop-player-scroll" mode="Vertical" class="item-source-scroll">
        <ui:VisualElement name="shop-player-list" />
      </ui:ScrollView>
      <ui:Label name="shop-player-empty" class="item-source-empty" picking-mode="Ignore">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="window.empty_source" />
        </Bindings>
      </ui:Label>
    </ui:Foldout>
    <ui:VisualElement class="shop-selection-summary">
      <ui:Label name="shop-selected-source" text="" class="shop-detail-line" />
      <ui:Label name="shop-selected-price" text="" class="shop-price" />
    </ui:VisualElement>
    <ui:Label name="shop-feedback" text="" class="shop-feedback" />
    <ui:VisualElement name="shop-actions" class="shop-actions">
      <ui:Button name="shop-buy" text="" class="item-context-action item-context-action--primary shop-buy">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="shop.buy.action" />
        </Bindings>
      </ui:Button>
      <ui:Button name="shop-sell" text="" class="item-context-action shop-sell">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="shop.sell.action" />
        </Bindings>
      </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement class="item-trade-drop-zones">
      <ui:Button name="shop-buy-zone" class="item-drop-zone"><Bindings><l:LocalizedString property="text" table="ui" entry="item.action.buy_zone" /></Bindings></ui:Button>
      <ui:Button name="shop-sell-zone" class="item-drop-zone"><Bindings><l:LocalizedString property="text" table="ui" entry="item.action.sell_zone" /></Bindings></ui:Button>
    </ui:VisualElement>
    <ui:Label text="" class="item-context-help">
      <Bindings>
        <l:LocalizedString property="text" table="ui" entry="shop.help.readonly" />
      </Bindings>
    </ui:Label>
  </ui:VisualElement>
</ui:UXML>