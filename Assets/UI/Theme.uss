.item-window {
  background-image: url("project://database/Assets/Art/Sprites/UI/Frames/ui_item_window_base.png?fileID=21300000&guid=fa17b4d2b1447a2479b6730851bc615f&type=3");
  -unity-slice-left: 96;
  -unity-slice-right: 96;
  -unity-slice-top: 96;
  -unity-slice-bottom: 96;
  -unity-slice-scale: 0.125;
}

Button:hover {
  background-color: rgb(61, 66, 76);
}

Button:focus {
  border-left-width: 2px;
  border-right-width: 2px;
  border-top-width: 2px;
  border-bottom-width: 2px;
  border-left-color: rgb(246, 203, 126);
  border-right-color: rgb(246, 203, 126);
  border-top-color: rgb(246, 203, 126);
  border-bottom-color: rgb(246, 203, 126);
}

Button:active {
  scale: 0.97 0.97;
  background-color: rgb(91, 70, 43);
}

Button:disabled {
  opacity: 0.42;
  color: rgb(109, 113, 122);
  background-color: rgb(42, 45, 51);
  border-left-color: rgb(59, 63, 71);
  border-right-color: rgb(59, 63, 71);
  border-top-color: rgb(59, 63, 71);
  border-bottom-color: rgb(59, 63, 71);
}

.ui-icon {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.ui-icon--health {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_health.png?fileID=21300000&guid=0cf093226e4ff984f8f05943a35c4c87&type=3");
}

.ui-icon--gold {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_gold.png?fileID=21300000&guid=d8ac47a9d99c13247946bc4941ac2d60&type=3");
}

.ui-icon--weapon {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_weapon.png?fileID=21300000&guid=b7f0a8b24b110f845b39d59693b14cc4&type=3");
}

.ui-icon--armor {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_armor.png?fileID=21300000&guid=c99d8de66959e404cbf64bbef2bc3b58&type=3");
}

.ui-icon--ring {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_ring.png?fileID=21300000&guid=c3657d599f6833e43a465b890033398e&type=3");
}

.ui-icon--inventory {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_inventory.png?fileID=21300000&guid=ff3f9a1742cf9d4438339ccce8be8eee&type=3");
}

.ui-icon--shop {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_shop.png?fileID=21300000&guid=b29338138fd2c704e9026d3d44b1febe&type=3");
}

.ui-icon--crafting {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_crafting.png?fileID=21300000&guid=47116b89afccbea47b41f954b70a7315&type=3");
}

.ui-icon--close {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_close.png?fileID=21300000&guid=f88d2fc91b328eb419c66f65abda751a&type=3");
}

.item-icon--missing {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_missing.png?fileID=21300000&guid=14bbd91baeecb464f9e63ec95fa2cc2f&type=3");
  -unity-background-scale-mode: scale-to-fit;
}

.crafting-item {
  flex-direction: row;
  align-items: center;
}

.crafting-item-icon {
  width: 48px;
  height: 48px;
  margin-right: 10px;
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.crafting-item-summary {
  flex-grow: 1;
  white-space: normal;
  -unity-text-align: middle-left;
}

.inventory-equipment-slot {
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
}

.inventory-equipment-slot-icon {
  width: 42px;
  height: 42px;
  margin-right: 7px;
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.inventory-equipment-slot-icon--weapon.inventory-equipment-slot-icon--empty {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_weapon.png?fileID=21300000&guid=b7f0a8b24b110f845b39d59693b14cc4&type=3");
  opacity: 0.35;
}

.inventory-equipment-slot-icon--armor.inventory-equipment-slot-icon--empty {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_armor.png?fileID=21300000&guid=c99d8de66959e404cbf64bbef2bc3b58&type=3");
  opacity: 0.35;
}

.inventory-equipment-slot-icon--ring.inventory-equipment-slot-icon--empty {
  background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_ring.png?fileID=21300000&guid=c3657d599f6833e43a465b890033398e&type=3");
  opacity: 0.35;
}

.inventory-item--normal,
.shop-item--normal,
.crafting-item--normal,
.item-detail--normal .item-detail-icon {
  border-left-width: 2px;
  border-left-color: rgb(153, 158, 168);
}

.inventory-item--magic,
.shop-item--magic,
.crafting-item--magic,
.item-detail--magic .item-detail-icon {
  border-left-width: 3px;
  border-left-color: rgb(92, 138, 220);
  border-top-color: rgb(92, 138, 220);
}

.inventory-item--rare,
.shop-item--rare,
.crafting-item--rare,
.item-detail--rare .item-detail-icon {
  border-left-width: 4px;
  border-left-color: rgb(220, 176, 63);
  border-top-color: rgb(220, 176, 63);
  border-bottom-right-radius: 0;
}

.inventory-item--unique,
.shop-item--unique,
.crafting-item--unique,
.item-detail--unique .item-detail-icon {
  border-left-width: 5px;
  border-left-color: rgb(211, 105, 48);
  border-top-color: rgb(211, 105, 48);
  border-bottom-color: rgb(211, 105, 48);
  border-top-right-radius: 0;
  border-bottom-left-radius: 0;
}

.game-menu-tab--active,
.inventory-item--selected,
.inventory-equipment-slot--selected,
.shop-item--selected,
.crafting-item--selected,
.crafting-affix--selected {
  border-left-color: rgb(246, 203, 126);
  border-right-color: rgb(246, 203, 126);
  border-top-color: rgb(246, 203, 126);
  border-bottom-color: rgb(246, 203, 126);
}


.hud-card--row {
  flex-direction: row;
  align-items: center;
}

.hud-leading-icon {
  width: 44px;
  height: 44px;
  margin-right: 14px;
}

.hud-card-content {
  flex-grow: 1;
}

.hud-card-content--compact {
  align-items: flex-end;
}

.game-menu-tab,
.game-menu-close {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.game-menu-tab-icon {
  width: 24px;
  height: 24px;
  margin-right: 8px;
}

.game-menu-close-icon {
  width: 22px;
  height: 22px;
  margin-right: 7px;
}

.game-menu-tab-label {
  -unity-font-style: bold;
}
