.game-menu-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: none;
  justify-content: center;
  align-items: center;
  background-color: rgba(5, 7, 10, 0.84);
}

.game-menu-panel {
  width: 1220px;
  max-width: 94%;
  height: 760px;
  max-height: 92%;
  padding: 24px;
  color: rgb(224, 226, 231);
  background-color: rgb(20, 24, 31);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(116, 91, 54);
  border-right-color: rgb(116, 91, 54);
  border-top-color: rgb(116, 91, 54);
  border-bottom-color: rgb(116, 91, 54);
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  border-bottom-left-radius: 10px;
  border-bottom-right-radius: 10px;
}

.game-menu-header {
  height: 72px;
  flex-direction: row;
  align-items: center;
  border-bottom-width: 1px;
  border-bottom-color: rgb(63, 67, 75);
}

.game-menu-heading {
  width: 320px;
  flex-direction: row;
  align-items: center;
}

.game-menu-title {
  margin-right: 12px;
  font-size: 30px;
  -unity-font-style: bold;
  color: rgb(241, 232, 210);
}

.game-menu-kicker {
  font-size: 11px;
  letter-spacing: 3px;
  color: rgb(166, 132, 77);
}

.game-menu-tabs {
  flex-grow: 1;
  flex-direction: row;
  justify-content: center;
}

.game-menu-tab {
  min-width: 140px;
  height: 40px;
  margin-left: 5px;
  margin-right: 5px;
  color: rgb(177, 182, 191);
  background-color: rgb(32, 37, 45);
  border-left-color: rgb(64, 70, 81);
  border-right-color: rgb(64, 70, 81);
  border-top-color: rgb(64, 70, 81);
  border-bottom-color: rgb(64, 70, 81);
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
}

.game-menu-tab:hover,
.game-menu-tab:focus,
.game-menu-tab--active {
  color: rgb(246, 235, 213);
  background-color: rgb(75, 62, 43);
  border-left-color: rgb(194, 150, 78);
  border-right-color: rgb(194, 150, 78);
  border-top-color: rgb(194, 150, 78);
  border-bottom-color: rgb(194, 150, 78);
}

.game-menu-close {
  min-width: 150px;
  height: 38px;
  color: rgb(209, 211, 216);
  background-color: rgb(40, 45, 54);
  border-left-color: rgb(80, 85, 96);
  border-right-color: rgb(80, 85, 96);
  border-top-color: rgb(80, 85, 96);
  border-bottom-color: rgb(80, 85, 96);
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
}

.game-menu-close:hover,
.game-menu-close:focus {
  color: white;
  background-color: rgb(57, 63, 74);
  border-left-color: rgb(180, 143, 82);
  border-right-color: rgb(180, 143, 82);
  border-top-color: rgb(180, 143, 82);
  border-bottom-color: rgb(180, 143, 82);
}

.game-menu-content {
  flex-grow: 1;
}