.application-shell {
  width: 100%;
  height: 100%;
  flex-grow: 1;
  color: rgb(226, 222, 212);
  -unity-font-definition: url("project://database/Assets/Settings/UI/Fonts/GameCjkFont.asset?fileID=11400000&guid=3a18e112c5f806146b5754b6d8ec227c&type=2");
}

.application-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.application-front-end {
  display: none;
  align-items: flex-start;
  justify-content: center;
  padding-left: 9%;
  padding-top: 11%;
  background-color: rgb(12, 14, 18);
}

.front-end-vignette {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(25, 19, 15, 0.38);
}

.front-end-panel {
  width: 520px;
  min-height: 550px;
  padding: 42px;
  background-color: rgba(24, 27, 33, 0.96);
  border-left-width: 2px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(201, 151, 76);
  border-right-color: rgb(70, 74, 83);
  border-top-color: rgb(70, 74, 83);
  border-bottom-color: rgb(70, 74, 83);
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  border-bottom-left-radius: 8px;
  border-bottom-right-radius: 8px;
}

.front-end-kicker {
  color: rgb(201, 151, 76);
  font-size: 17px;
  letter-spacing: 5px;
  margin-bottom: 12px;
}

.front-end-title {
  color: rgb(246, 239, 220);
  font-size: 52px;
  -unity-font-style: bold;
  white-space: normal;
  margin-bottom: 12px;
}

.front-end-subtitle {
  color: rgb(157, 162, 174);
  font-size: 18px;
  white-space: normal;
  margin-bottom: 38px;
}

.front-end-actions {
  margin-top: auto;
}

.front-end-action,
.front-end-language {
  height: 52px;
  margin-top: 10px;
  font-size: 19px;
  color: rgb(226, 222, 212);
  background-color: rgb(43, 47, 56);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(75, 80, 91);
  border-right-color: rgb(75, 80, 91);
  border-top-color: rgb(75, 80, 91);
  border-bottom-color: rgb(75, 80, 91);
}

.front-end-action--primary {
  color: rgb(29, 24, 18);
  background-color: rgb(218, 172, 98);
  -unity-font-style: bold;
}

.front-end-action--quiet {
  margin-top: 24px;
  background-color: rgba(31, 34, 41, 0.8);
}

.front-end-version {
  position: absolute;
  right: 30px;
  bottom: 22px;
  color: rgb(98, 103, 114);
  font-size: 13px;
}

.application-blocker {
  display: none;
  align-items: center;
  justify-content: center;
  background-color: rgba(5, 6, 8, 0.78);
}

.application-dialog,
.application-busy-card {
  width: 520px;
  padding: 30px;
  background-color: rgb(28, 31, 38);
  border-left-width: 2px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(201, 151, 76);
  border-right-color: rgb(78, 82, 92);
  border-top-color: rgb(78, 82, 92);
  border-bottom-color: rgb(78, 82, 92);
}

.application-dialog-title {
  color: rgb(239, 225, 195);
  font-size: 27px;
  -unity-font-style: bold;
  margin-bottom: 14px;
}

.application-dialog-message,
.application-busy-label {
  color: rgb(201, 204, 211);
  font-size: 17px;
  white-space: normal;
  margin-bottom: 24px;
}

.application-dialog-actions {
  flex-direction: row;
  justify-content: flex-end;
}

.application-dialog-action,
.application-busy-cancel {
  min-width: 130px;
  height: 44px;
  margin-left: 10px;
  color: rgb(226, 222, 212);
  background-color: rgb(45, 49, 58);
}

.application-dialog-action--primary {
  color: rgb(29, 24, 18);
  background-color: rgb(218, 172, 98);
  -unity-font-style: bold;
}

.application-busy-progress {
  height: 18px;
  margin-bottom: 20px;
}

.application-busy-cancel {
  align-self: flex-end;
}

.application-toast {
  display: none;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 42px;
}

.application-toast-message {
  max-width: 620px;
  padding: 14px 24px;
  color: rgb(236, 231, 218);
  background-color: rgba(30, 34, 41, 0.95);
  border-left-width: 3px;
  border-left-color: rgb(201, 151, 76);
  font-size: 16px;
}

.application-fatal {
  background-color: rgba(20, 5, 7, 0.94);
}

.application-dialog--fatal {
  border-left-color: rgb(181, 62, 70);
}

.application-settings {
  background-color: rgba(5, 6, 8, 0.9);
}

.application-settings-panel {
  width: 900px;
  max-width: 92%;
  height: 820px;
  max-height: 92%;
  padding: 24px;
  background-color: rgb(24, 27, 33);
  border-left-width: 2px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(201, 151, 76);
  border-right-color: rgb(70, 74, 83);
  border-top-color: rgb(70, 74, 83);
  border-bottom-color: rgb(70, 74, 83);
}

.application-settings-header {
  min-height: 54px;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  border-bottom-width: 1px;
  border-bottom-color: rgb(70, 74, 83);
}

.application-settings-title {
  flex-grow: 1;
  color: rgb(239, 225, 195);
  font-size: 30px;
  -unity-font-style: bold;
}

.application-settings-back,
.application-settings-restore {
  min-width: 150px;
  height: 40px;
  color: rgb(226, 222, 212);
  background-color: rgb(45, 49, 58);
}

.application-settings-scroll {
  flex-grow: 1;
  min-height: 0;
}

.application-settings-section {
  margin-bottom: 16px;
  padding: 16px;
  background-color: rgb(31, 35, 42);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(66, 70, 80);
  border-right-color: rgb(66, 70, 80);
  border-top-color: rgb(66, 70, 80);
  border-bottom-color: rgb(66, 70, 80);
}

.application-settings-section-title {
  margin-bottom: 12px;
  color: rgb(218, 172, 98);
  font-size: 21px;
  -unity-font-style: bold;
}

.application-settings-slider,
.application-settings-toggle,
.application-settings-dropdown {
  min-height: 38px;
  margin-bottom: 8px;
  color: rgb(218, 220, 226);
}

.application-settings-binding-list {
  margin-top: 10px;
  margin-bottom: 12px;
}

.application-settings-binding-row {
  min-height: 44px;
  flex-direction: row;
  align-items: center;
  margin-bottom: 5px;
  padding-left: 8px;
  background-color: rgb(38, 42, 50);
}

.application-settings-binding-name {
  flex-grow: 1;
  min-width: 240px;
  white-space: normal;
  color: rgb(207, 210, 217);
}

.application-settings-binding-glyph {
  width: 36px;
  height: 36px;
  margin-right: 8px;
  align-items: center;
  justify-content: center;
  -unity-background-scale-mode: scale-to-fit;
}

.application-settings-binding-glyph-text {
  font-size: 10px;
  -unity-font-style: bold;
  color: rgb(239, 231, 212);
  -unity-text-align: middle-center;
}

.application-settings-binding-action {
  width: 210px;
  height: 36px;
  color: rgb(226, 222, 212);
  background-color: rgb(49, 54, 64);
}

.application-settings-binding-action:focus,
.application-settings-back:focus,
.application-settings-restore:focus {
  border-left-color: rgb(218, 172, 98);
  border-right-color: rgb(218, 172, 98);
  border-top-color: rgb(218, 172, 98);
  border-bottom-color: rgb(218, 172, 98);
}

.application-settings-status {
  min-height: 28px;
  margin-top: 8px;
  white-space: normal;
  color: rgb(169, 174, 184);
}

.input-glyph--keyboard-keycap {
  background-image: url("project://database/Assets/Art/UI/InputGlyphs/keyboard_keycap.png");
}

.input-glyph--gamepad-button_south {
  background-image: url("project://database/Assets/Art/UI/InputGlyphs/gamepad_button_south.png");
}

.input-glyph--gamepad-button_east {
  background-image: url("project://database/Assets/Art/UI/InputGlyphs/gamepad_button_east.png");
}

.input-glyph--gamepad-button_west {
  background-image: url("project://database/Assets/Art/UI/InputGlyphs/gamepad_button_west.png");
}

.input-glyph--gamepad-button_north {
  background-image: url("project://database/Assets/Art/UI/InputGlyphs/gamepad_button_north.png");
}

.input-glyph--gamepad-start {
  background-image: url("project://database/Assets/Art/UI/InputGlyphs/gamepad_start.png");
}

.input-glyph--gamepad-dpad {
  background-image: url("project://database/Assets/Art/UI/InputGlyphs/gamepad_dpad.png");
}

.input-glyph--gamepad-left_stick {
  background-image: url("project://database/Assets/Art/UI/InputGlyphs/gamepad_left_stick.png");
}
