.game-ui-root { flex-grow: 1; }
.hud-template { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hud-root { position: absolute; left: 0; right: 0; bottom: 12px; align-items: center; color: rgb(230,214,184); }
.hud-root Label { margin: 0; padding: 0; }
.hud-combat-row { flex-direction: row; align-items: stretch; }
.hud-resource { width: 160px; min-height: 104px; flex-shrink: 0; padding: 15px 14px; background-color: rgb(18,22,27); background-image: url("project://database/Assets/Art/Sprites/UI/Frames/ui_hud_resource_base.png"); -unity-slice-left: 96; -unity-slice-right: 96; -unity-slice-top: 96; -unity-slice-bottom: 96; -unity-slice-scale: 0.125px; }
.hud-caption { white-space: normal; font-size: 16px; color: rgb(220,204,175); }
.hud-root .hud-resource-state { margin-top: 5px; font-size: 12px; white-space: normal; color: rgb(188,184,173); }
#health-bar, #mana-bar { height: 28px; min-height: 28px; margin: 6px 0 0 0; }
#health-bar .unity-progress-bar__background, #mana-bar .unity-progress-bar__background { background-color: rgb(8,11,15); border-radius: 0; }
#health-bar .unity-progress-bar__progress { background-color: rgb(173,36,48); border-radius: 0; }
#mana-bar .unity-progress-bar__progress { background-color: rgb(34,86,165); border-radius: 0; }
#health-bar .unity-progress-bar__title, #mana-bar .unity-progress-bar__title { color: rgb(255,242,220); -unity-font-style: bold; font-size: 16px; }
.hud-center { margin: 0 8px; padding: 4px 6px; background-color: rgba(12,16,21,0.96); border-width: 1px; border-color: rgb(83,73,57); }
.hud-actions, .hud-flames { flex-direction: row; align-items: flex-start; }
.hud-skill-slot { min-width: 64px; margin: 0 2px; align-items: center; flex-shrink: 0; }
.hud-icon-frame { width: 56px; height: 56px; flex-shrink: 0; background-color: rgb(17,21,25); border-width: 1px; border-color: rgb(128,105,62); background-image: url("project://database/Assets/Art/Sprites/UI/Frames/ui_slot_base.png"); -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; -unity-slice-scale: 0.125px; }
.hud-skill-slot:hover .hud-icon-frame { border-color: rgb(231,188,102); }
.hud-skill-icon { position: absolute; left: 3px; right: 3px; top: 3px; bottom: 3px; -unity-background-scale-mode: scale-to-fit; }
.hud-skill-icon--missing { background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_missing.png"); }
.hud-skill--empty .hud-skill-icon { background-image: none; }
.hud-skill--unavailable .hud-icon-frame { border-color: rgb(78,76,70); }
.hud-skill--unavailable .hud-skill-icon { opacity: 0.45; }
.hud-skill-state { font-size: 12px; min-height: 18px; max-width: 96px; white-space: normal; -unity-text-align: upper-center; color: rgb(224,185,127); }
.hud-root .hud-binding { min-width: 28px; min-height: 24px; max-width: 160px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; -unity-text-align: middle-center; font-size: 12px; white-space: normal; color: rgb(218,196,155); }
.hud-root .hud-binding--text { padding: 0 4px; border-width: 1px; border-color: rgb(116,96,65); background-color: rgb(17,20,25); }
.hud-cooldown { position: absolute; left: 0; right: 0; top: 0; bottom: 0; margin: 0; padding: 0; }
.hud-cooldown .unity-progress-bar__container, .hud-cooldown .unity-progress-bar__background, .hud-cooldown .unity-progress-bar__progress { height: 100%; min-height: 0; padding: 0; margin: 0; border-width: 0; border-radius: 0; }
.hud-cooldown .unity-progress-bar__background { background-color: transparent; }
.hud-cooldown .unity-progress-bar__progress { background-color: rgba(0,0,0,0.76); }
.hud-cooldown .unity-progress-bar__title { display: none; }
.hud-cooldown-time { position: absolute; left: 0; right: 0; top: 0; bottom: 0; font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(255,242,220); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0,0,0); }
.hud-entries { flex-direction: row; align-items: center; align-self: center; margin-left: 6px; flex-shrink: 0; }
.game-ui-root .hud-entry { width: auto; min-width: 44px; min-height: 44px; margin: 0 2px; padding: 5px; align-items: center; justify-content: center; flex-shrink: 0; }
.hud-entry-icon { width: 28px; height: 28px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.hud-entry-icon--inventory { background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_inventory.png"); }
.hud-entry-icon--attributes { background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_armor.png"); }
.hud-entry-icon--board { background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_talent.png"); }
.hud-entry-icon--pause { background-image: url("project://database/Assets/Art/Sprites/UI/Icons/ui_icon_pause.png"); }
#gold-label { font-size: 12px; color: rgb(224,185,104); -unity-text-align: middle-right; min-height: 18px; white-space: normal; }
.hud-flames--hidden { display: none; }
.hud-resource--low #hud-health-state { color: rgb(244,122,104); }
.hud-low-warning { position: absolute; left: 0; right: 0; top: 0; bottom: 0; border-width: 3px; border-color: rgb(197,48,44); opacity: 0; }
.hud-skill-tooltip { display: none; position: absolute; width: 360px; padding: 12px 16px; background-color: rgb(16,19,24); border-width: 1px; border-color: rgb(161,128,72); }
.hud-skill-tooltip Label { white-space: normal; flex-shrink: 0; }
#hud-skill-name { font-size: 17px; color: rgb(240,213,157); }
.hud-root #hud-skill-details { margin-top: 6px; font-size: 14px; color: rgb(205,198,180); }
.hud-root #hud-detail-status { margin-top: 5px; font-size: 14px; color: rgb(224,185,127); }
.interaction-prompt { display: none; max-width: 840px; padding: 8px 18px; margin-bottom: 12px; background-color: rgba(16,19,24,0.96); border-width: 1px; border-color: rgb(123,101,63); }
.interaction-prompt__label { font-size: 17px; white-space: normal; -unity-text-align: middle-center; color: rgb(237,219,183); }
