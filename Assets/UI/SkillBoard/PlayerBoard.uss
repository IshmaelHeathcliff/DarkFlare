.board-window { width: 1240px; }
.board-template, .board-content { flex-grow: 1; min-height: 0; }
.board-header, .board-workspace, .board-skill-slots, .board-tool-grid { flex-direction: row; }
.board-header { align-items: center; flex-shrink: 0; margin-bottom: 4px; }
.board-summary { flex-grow: 1; min-width: 0; margin-bottom: 0; }
.board-text { white-space: normal; font-size: 14px; color: rgb(220,207,180); margin-bottom: 5px; flex-shrink: 0; }
.board-title { white-space: normal; font-size: 18px; color: rgb(241,212,158); margin-bottom: 8px; flex-shrink: 0; }
.board-button { min-height: 30px; height: auto; white-space: normal; font-size: 14px; margin: 2px; padding: 4px 6px; flex-shrink: 0; color: rgb(230,213,180); background-color: rgb(26,28,32); border-width: 1px; border-color: rgb(99,81,52); }
.board-button:focus { border-color: rgb(238,192,100); }
.board-button:disabled { color: rgb(128,125,116); }
.board-workspace { flex-grow: 1; min-height: 0; }
.board-view-column { flex-grow: 1; min-width: 0; min-height: 0; }
.board-viewport { flex-grow: 1; min-height: 200px; border-width: 1px; border-color: rgb(91,76,53); overflow: hidden; }
.board-canvas { flex-grow: 1; min-height: 0; overflow: hidden; }
.board-canvas:focus { border-width: 1px; border-color: rgb(220,173,80); }
.board-details-scroll { width: 228px; min-width: 0; flex-shrink: 0; margin-left: 8px; }
.board-details-scroll .unity-scroll-view__content-container { padding-right: 4px; }
.board-cell-label { position: absolute; min-width: 32px; height: 22px; translate: -50% -50%; font-size: 10px; -unity-text-align: middle-center; color: rgb(255,237,187); }
.board-help { white-space: normal; font-size: 12px; color: rgb(180,174,159); margin-top: 3px; margin-bottom: 0; flex-shrink: 0; }
.board-skill-slots { flex-shrink: 0; margin-top: 4px; }
.board-skill-slot { flex-grow: 1; flex-basis: 0; min-width: 0; font-size: 12px; padding: 3px; }
.board-skill-slot--filled { border-color: rgb(173,120,52); background-color: rgb(48,36,23); }
.board-skill-slot--selected { border-color: rgb(238,192,100); }
.board-actions { flex-shrink: 0; }
.board-link { min-height: 28px; margin-bottom: 6px; }
.board-link .unity-toggle__input { flex-grow: 1; min-width: 0; }
.board-link .unity-toggle__text { white-space: normal; flex-shrink: 1; min-width: 0; }
.board-tools-popup { position: absolute; right: 0; top: 42px; width: 400px; padding: 8px; background-color: rgb(15,18,23); border-width: 2px; border-color: rgb(173,139,75); }
.board-tool-grid { flex-wrap: wrap; }
.board-tool-grid .board-button { flex-grow: 1; flex-basis: 45%; min-width: 0; }
.board-hidden { display: none; }
.game-menu-panel--board .item-tooltip { display: none; }
.board-selected-icon { width: 48px; height: 48px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
#game-menu-board-tab { width: auto; max-width: none; min-width: 92px; flex-shrink: 0; white-space: nowrap; }
