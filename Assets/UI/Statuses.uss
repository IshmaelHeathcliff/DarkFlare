.status-hud { position: absolute; top: 16px; right: 16px; width: 512px; max-width: 40%; align-items: flex-end; }
.status-icons { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.status-icon { width: 58px; height: 64px; padding: 2px; margin: 3px; background-color: rgb(23, 28, 32); border-width: 1px; border-color: rgb(105, 84, 56); font-size: 11px; white-space: normal; }
.status-icon:hover, .status-icon:focus { border-color: rgb(98, 216, 255); background-color: rgb(43, 51, 57); }
.status-icon-picture { width: 40px; height: 40px; align-self: center; -unity-background-scale-mode: scale-to-fit; }
.status-icon-count { position: absolute; right: 3px; top: 1px; color: rgb(255, 239, 200); font-size: 14px; -unity-font-style: bold; }
.status-icon-time { position: absolute; bottom: 2px; left: 2px; right: 2px; -unity-text-align: middle-center; font-size: 13px; }
.status-window { display: none; width: 940px; height: 540px; padding: 16px; align-self: center; }
.status-body { flex-direction: row; flex-grow: 1; margin-top: 12px; }
.status-actors { width: 260px; flex-shrink: 0; margin-right: 18px; }
.status-actor { min-height: 42px; margin-bottom: 5px; padding: 6px; white-space: normal; -unity-text-align: middle-left; }
.status-actor--selected { border-color: rgb(181, 138, 69); color: rgb(242, 219, 172); }
.status-main { flex-grow: 1; }
.status-actor-title { font-size: 22px; margin-bottom: 16px; white-space: normal; }
.status-empty, .status-help { margin-top: 20px; white-space: normal; color: rgb(167, 176, 183); }
.status-tooltip { display: none; position: absolute; padding: 14px; min-height: 80px; }
.status-details { white-space: normal; font-size: 16px; color: rgb(230, 232, 233); }
#status-detail-scroll { flex-shrink: 1; }

.game-menu-header > .game-menu-tab { min-width: 94px; max-width: 150px; flex-shrink: 1; white-space: normal; height: 44px; font-size: 14px; padding: 0 6px; margin-top: 0; margin-bottom: 0; }
#status-close { width: auto; min-width: 98px; max-width: 240px; min-height: 36px; height: auto; flex-shrink: 0; white-space: normal; }

.game-menu-header { height: 44px; min-height: 44px; }
.status-details { flex-shrink: 0; }

#status-hud-icons { width: 100%; justify-content: flex-end; }
.status-visibility-toggle { min-height: 36px; max-width: 320px; padding: 4px 10px; margin-right: 8px; white-space: normal; font-size: 14px; flex-shrink: 0; }
#status-hud-visibility-toggle { margin-right: 3px; margin-bottom: 4px; }
.status-window > .item-window-header { height: auto; min-height: 44px; flex-shrink: 0; }
