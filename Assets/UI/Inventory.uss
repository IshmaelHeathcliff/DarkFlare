.inventory-template,
.inventory-page {
  flex-grow: 1;
}

.inventory-page {
  display: none;
  padding-top: 20px;
}

.inventory-body {
  flex-grow: 1;
  flex-direction: row;
}

.inventory-grid-section {
  flex-grow: 1;
  min-width: 520px;
  padding-right: 18px;
}

.inventory-section-title {
  height: 28px;
  margin-bottom: 10px;
  font-size: 16px;
  -unity-font-style: bold;
  color: rgb(195, 168, 120);
}

.inventory-grid-frame {
  flex-grow: 1;
  min-height: 350px;
  justify-content: center;
  align-items: center;
  padding: 28px;
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_inventory_panel.png");
  -unity-slice-left: 28;
  -unity-slice-right: 28;
  -unity-slice-top: 28;
  -unity-slice-bottom: 28;
}

.inventory-grid {
  position: relative;
}

.inventory-cell {
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_normal.png");
  -unity-slice-left: 10;
  -unity-slice-right: 10;
  -unity-slice-top: 10;
  -unity-slice-bottom: 10;
}

.inventory-item {
  padding: 5px;
  align-items: center;
  justify-content: center;
  white-space: normal;
  font-size: 12px;
  -unity-font-style: bold;
  color: rgb(230, 232, 233);
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_normal.png");
  -unity-slice-left: 10;
  -unity-slice-right: 10;
  -unity-slice-top: 10;
  -unity-slice-bottom: 10;
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0;
}

.inventory-item:hover,
.inventory-item:focus,
.inventory-item--selected {
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_focus.png");
}

.inventory-item:disabled {
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_disabled.png");
}

.inventory-item-icon {
  flex-grow: 1;
  min-width: 28px;
  min-height: 28px;
  width: 100%;
  -unity-background-scale-mode: scale-to-fit;
}

.inventory-item-icon--weapon {
  background-image: url("project://database/Assets/Art/Sprites/Items/Equipment/weapon_greatsword.png");
}

.inventory-item-label {
  min-height: 18px;
  padding-left: 3px;
  padding-right: 3px;
  white-space: normal;
  font-size: 11px;
  -unity-text-align: middle-center;
  color: rgb(230, 232, 233);
  background-color: rgba(17, 24, 33, 0.78);
}

.inventory-item--normal {
  border-left-color: rgb(146, 151, 160);
  border-right-color: rgb(146, 151, 160);
  border-top-color: rgb(146, 151, 160);
  border-bottom-color: rgb(146, 151, 160);
}

.inventory-item--magic {
  color: rgb(156, 191, 255);
  border-left-color: rgb(76, 121, 204);
  border-right-color: rgb(76, 121, 204);
  border-top-color: rgb(76, 121, 204);
  border-bottom-color: rgb(76, 121, 204);
}

.inventory-item--rare {
  color: rgb(255, 226, 126);
  border-left-color: rgb(203, 164, 52);
  border-right-color: rgb(203, 164, 52);
  border-top-color: rgb(203, 164, 52);
  border-bottom-color: rgb(203, 164, 52);
  border-left-width: 3px;
}

.inventory-item--unique {
  color: rgb(255, 178, 91);
  border-left-color: rgb(205, 103, 42);
  border-right-color: rgb(205, 103, 42);
  border-top-color: rgb(205, 103, 42);
  border-bottom-color: rgb(205, 103, 42);
  border-left-width: 4px;
}

.inventory-empty {
  position: absolute;
  color: rgb(105, 111, 123);
  font-size: 18px;
  -unity-font-style: italic;
}

.inventory-help {
  height: 30px;
  padding-top: 10px;
  color: rgb(115, 121, 133);
  font-size: 12px;
}

.inventory-equipment {
  width: 184px;
  margin-right: 18px;
  padding: 18px;
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_inventory_panel.png");
  -unity-slice-left: 28;
  -unity-slice-right: 28;
  -unity-slice-top: 28;
  -unity-slice-bottom: 28;
}

.inventory-equipment-slot {
  min-height: 66px;
  margin-bottom: 12px;
  padding: 9px;
  white-space: normal;
  -unity-text-align: middle-center;
  color: rgb(187, 192, 201);
  background-color: rgb(28, 34, 43);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_normal.png");
  -unity-slice-left: 10;
  -unity-slice-right: 10;
  -unity-slice-top: 10;
  -unity-slice-bottom: 10;
}

.inventory-equipment-slot:hover,
.inventory-equipment-slot:focus,
.inventory-equipment-slot--selected {
  color: rgb(246, 235, 213);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_focus.png");
}

.inventory-equipment-slot--filled {
  color: rgb(221, 202, 163);
}

.inventory-equipment-help {
  min-height: 46px;
  margin-top: 4px;
  white-space: normal;
  font-size: 11px;
  color: rgb(115, 121, 133);
}

.inventory-details {
  width: 326px;
  padding: 22px;
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_inventory_panel.png");
  -unity-slice-left: 28;
  -unity-slice-right: 28;
  -unity-slice-top: 28;
  -unity-slice-bottom: 28;
}

.inventory-target-slot {
  min-height: 40px;
  padding: 10px;
  white-space: normal;
  color: rgb(221, 202, 163);
  background-color: rgb(38, 42, 49);
  border-left-width: 3px;
  border-left-color: rgb(168, 126, 62);
}

.inventory-divider {
  height: 1px;
  margin-top: 12px;
  margin-bottom: 12px;
  background-color: rgb(65, 70, 80);
}

.inventory-detail-line {
  height: 30px;
  color: rgb(178, 182, 191);
}

.inventory-item-detail {
  flex-grow: 1;
  min-height: 190px;
}

.inventory-comparison-title {
  min-height: 22px;
  margin-top: 8px;
  -unity-font-style: bold;
  color: rgb(195, 168, 120);
}

.inventory-comparison-scroll {
  height: 74px;
  min-height: 56px;
  margin-bottom: 8px;
  padding: 7px;
  background-color: rgb(27, 32, 40);
}

.inventory-comparison {
  white-space: normal;
  color: rgb(160, 168, 180);
}

.inventory-feedback {
  min-height: 40px;
  margin-bottom: 8px;
  white-space: normal;
  color: rgb(159, 166, 179);
}

.inventory-actions {
  height: 44px;
  flex-direction: row;
}

.inventory-action {
  flex-grow: 1;
  height: 44px;
  font-size: 14px;
  -unity-font-style: bold;
}

.inventory-equip {
  margin-right: 6px;
  color: rgb(28, 24, 18);
  background-color: rgb(211, 169, 94);
  border-left-color: rgb(239, 202, 132);
  border-right-color: rgb(239, 202, 132);
  border-top-color: rgb(239, 202, 132);
  border-bottom-color: rgb(239, 202, 132);
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
}

.inventory-equip:hover,
.inventory-equip:focus {
  background-color: rgb(238, 193, 109);
}

.inventory-equip:disabled {
  color: rgb(105, 108, 114);
  background-color: rgb(48, 51, 57);
  border-left-color: rgb(62, 65, 72);
  border-right-color: rgb(62, 65, 72);
  border-top-color: rgb(62, 65, 72);
  border-bottom-color: rgb(62, 65, 72);
}

.inventory-unequip {
  margin-left: 6px;
  color: rgb(213, 216, 222);
  background-color: rgb(48, 53, 62);
  border-left-color: rgb(78, 84, 96);
  border-right-color: rgb(78, 84, 96);
  border-top-color: rgb(78, 84, 96);
  border-bottom-color: rgb(78, 84, 96);
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
}

.inventory-unequip:hover,
.inventory-unequip:focus {
  color: white;
  background-color: rgb(66, 72, 84);
  border-left-color: rgb(177, 139, 78);
  border-right-color: rgb(177, 139, 78);
  border-top-color: rgb(177, 139, 78);
  border-bottom-color: rgb(177, 139, 78);
}

.inventory-unequip:disabled {
  color: rgb(105, 108, 114);
  background-color: rgb(42, 45, 51);
}
