.inventory-target-slot {
  min-height: 44px;
  padding: 10px;
  white-space: normal;
  color: rgb(221, 202, 163);
  background-color: rgb(31, 34, 40);
  border-left-width: 2px;
  border-left-color: rgb(168, 126, 62);
}

.inventory-feedback {
  min-height: 54px;
  margin-top: 8px;
  margin-bottom: 8px;
  white-space: normal;
  color: rgb(159, 166, 179);
}

.inventory-actions {
  flex-direction: row;
}

.inventory-actions .item-context-action {
  flex-grow: 1;
}

.inventory-actions .inventory-equip {
  margin-right: 6px;
}
