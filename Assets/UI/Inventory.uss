.inventory-target-slot {
  min-height: 40px;
  padding: 9px;
  white-space: normal;
  color: rgb(221, 202, 163);
  background-color: rgb(31, 34, 40);
  border-left-width: 2px;
  border-left-color: rgb(168, 126, 62);
}

.inventory-comparison-scroll {
  flex-grow: 1;
  min-height: 120px;
  margin-bottom: 8px;
  padding: 8px;
  background-color: rgb(24, 28, 35);
}

.inventory-comparison {
  white-space: normal;
  color: rgb(160, 168, 180);
}

.inventory-feedback {
  min-height: 62px;
  margin-bottom: 8px;
  white-space: normal;
  color: rgb(159, 166, 179);
}

.inventory-actions {
  flex-direction: column;
}
