.inventory-template,
.inventory-page {
  flex-grow: 1;
}

.inventory-page {
  display: none;
  padding-top: 20px;
}

.inventory-body {
  flex-grow: 1;
  flex-direction: row;
}

.inventory-grid-section {
  flex-grow: 1;
  min-width: 560px;
  padding-right: 26px;
}

.inventory-section-title {
  height: 28px;
  margin-bottom: 10px;
  font-size: 16px;
  -unity-font-style: bold;
  color: rgb(195, 168, 120);
}

.inventory-grid-frame {
  flex-grow: 1;
  min-height: 350px;
  justify-content: center;
  align-items: center;
  padding: 28px;
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_inventory_panel.png");
  -unity-slice-left: 28;
  -unity-slice-right: 28;
  -unity-slice-top: 28;
  -unity-slice-bottom: 28;
}

.inventory-grid {
  position: relative;
}

.inventory-cell {
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_normal.png");
  -unity-slice-left: 10;
  -unity-slice-right: 10;
  -unity-slice-top: 10;
  -unity-slice-bottom: 10;
}

.inventory-item {
  padding: 5px;
  align-items: center;
  justify-content: center;
  white-space: normal;
  font-size: 12px;
  -unity-font-style: bold;
  color: rgb(230, 232, 233);
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_normal.png");
  -unity-slice-left: 10;
  -unity-slice-right: 10;
  -unity-slice-top: 10;
  -unity-slice-bottom: 10;
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0;
}

.inventory-item:hover,
.inventory-item:focus,
.inventory-item--selected {
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_focus.png");
}

.inventory-item:disabled {
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_slot_disabled.png");
}

.inventory-item-icon {
  flex-grow: 1;
  min-width: 28px;
  min-height: 28px;
  width: 100%;
  -unity-background-scale-mode: scale-to-fit;
}

.inventory-item-icon--weapon {
  background-image: url("project://database/Assets/Art/Sprites/Items/Equipment/weapon_greatsword.png");
}

.inventory-item-label {
  min-height: 18px;
  padding-left: 3px;
  padding-right: 3px;
  white-space: normal;
  font-size: 11px;
  -unity-text-align: middle-center;
  color: rgb(230, 232, 233);
  background-color: rgba(17, 24, 33, 0.78);
}

.inventory-item--normal {
  border-left-color: rgb(146, 151, 160);
  border-right-color: rgb(146, 151, 160);
  border-top-color: rgb(146, 151, 160);
  border-bottom-color: rgb(146, 151, 160);
}

.inventory-item--magic {
  color: rgb(156, 191, 255);
  border-left-color: rgb(76, 121, 204);
  border-right-color: rgb(76, 121, 204);
  border-top-color: rgb(76, 121, 204);
  border-bottom-color: rgb(76, 121, 204);
}

.inventory-item--rare {
  color: rgb(255, 226, 126);
  border-left-color: rgb(203, 164, 52);
  border-right-color: rgb(203, 164, 52);
  border-top-color: rgb(203, 164, 52);
  border-bottom-color: rgb(203, 164, 52);
  border-left-width: 3px;
}

.inventory-item--unique {
  color: rgb(255, 178, 91);
  border-left-color: rgb(205, 103, 42);
  border-right-color: rgb(205, 103, 42);
  border-top-color: rgb(205, 103, 42);
  border-bottom-color: rgb(205, 103, 42);
  border-left-width: 4px;
}

.inventory-empty {
  position: absolute;
  color: rgb(105, 111, 123);
  font-size: 18px;
  -unity-font-style: italic;
}

.inventory-help {
  height: 30px;
  padding-top: 10px;
  color: rgb(115, 121, 133);
  font-size: 12px;
}

.inventory-details {
  width: 340px;
  padding: 30px;
  background-color: rgb(17, 24, 33);
  background-image: url("project://database/Assets/Art/Sprites/UI/ui_inventory_panel.png");
  -unity-slice-left: 28;
  -unity-slice-right: 28;
  -unity-slice-top: 28;
  -unity-slice-bottom: 28;
}

.inventory-current-weapon {
  min-height: 54px;
  padding: 12px;
  white-space: normal;
  color: rgb(221, 202, 163);
  background-color: rgb(38, 42, 49);
  border-left-width: 3px;
  border-left-color: rgb(168, 126, 62);
}

.inventory-divider {
  height: 1px;
  margin-top: 20px;
  margin-bottom: 20px;
  background-color: rgb(65, 70, 80);
}

.inventory-detail-line {
  height: 30px;
  color: rgb(178, 182, 191);
}

.inventory-details-spacer {
  flex-grow: 1;
}

.inventory-feedback {
  min-height: 48px;
  margin-bottom: 12px;
  white-space: normal;
  color: rgb(159, 166, 179);
}

.inventory-equip {
  height: 48px;
  font-size: 16px;
  -unity-font-style: bold;
  color: rgb(28, 24, 18);
  background-color: rgb(211, 169, 94);
  border-left-color: rgb(239, 202, 132);
  border-right-color: rgb(239, 202, 132);
  border-top-color: rgb(239, 202, 132);
  border-bottom-color: rgb(239, 202, 132);
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
}

.inventory-equip:hover,
.inventory-equip:focus {
  background-color: rgb(238, 193, 109);
}

.inventory-equip:disabled {
  color: rgb(105, 108, 114);
  background-color: rgb(48, 51, 57);
  border-left-color: rgb(62, 65, 72);
  border-right-color: rgb(62, 65, 72);
  border-top-color: rgb(62, 65, 72);
  border-bottom-color: rgb(62, 65, 72);
}
