.crafting-gold {
  min-height: 34px;
  margin-bottom: 8px;
  padding: 7px;
  color: rgb(244, 210, 124);
  background-color: rgb(34, 31, 24);
  -unity-font-style: bold;
}

.crafting-summary-line {
  min-height: 25px;
  padding-left: 6px;
  color: rgb(178, 184, 193);
}

.crafting-affix-scroll {
  flex-grow: 1;
  min-height: 160px;
  padding: 5px;
  background-color: rgb(23, 27, 34);
}

.crafting-affix {
  min-height: 46px;
  margin-bottom: 5px;
  white-space: normal;
  -unity-text-align: middle-left;
  color: rgb(203, 208, 215);
  background-color: rgb(33, 38, 46);
  border-left-width: 2px;
  border-left-color: rgb(105, 109, 119);
}

.crafting-affix:hover,
.crafting-affix:focus,
.crafting-affix--selected {
  background-color: rgb(58, 48, 34);
  border-left-color: rgb(204, 158, 79);
}

.crafting-affix--prefix {
  border-left-color: rgb(81, 130, 205);
}

.crafting-affix--suffix {
  border-left-color: rgb(171, 105, 187);
}

.crafting-empty {
  min-height: 24px;
  color: rgb(105, 111, 123);
  -unity-font-style: italic;
}

.crafting-selected-affix,
.crafting-selected-affix-detail {
  min-height: 27px;
  padding: 5px;
  white-space: normal;
  color: rgb(183, 188, 197);
}

.crafting-selected-affix {
  color: rgb(218, 193, 147);
}

.crafting-feedback {
  min-height: 48px;
  margin-top: 4px;
  white-space: normal;
  color: rgb(155, 162, 174);
}

.crafting-actions {
  flex-direction: row;
  flex-wrap: wrap;
}

.crafting-actions .item-context-action {
  width: 48%;
  margin-left: 1%;
  margin-right: 1%;
}
