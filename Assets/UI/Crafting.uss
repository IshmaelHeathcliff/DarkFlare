.crafting-gold {
  min-height: 34px;
  margin-bottom: 8px;
  padding: 7px;
  color: rgb(244, 210, 124);
  background-color: rgb(34, 31, 24);
  -unity-font-style: bold;
}

.crafting-selection-card {
  min-height: 170px;
  padding: 9px;
  flex-direction: row;
  align-items: center;
  background-color: rgb(23, 27, 34);
  border-left-width: 2px;
  border-left-color: rgb(151, 116, 61);
}

.crafting-input-slot {
  width: 100px;
  min-width: 100px;
  height: 152px;
  margin-right: 10px;
  padding: 4px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: rgb(145, 151, 161);
  background-color: rgb(16, 19, 24);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(62, 68, 78);
  border-right-color: rgb(62, 68, 78);
  border-top-color: rgb(62, 68, 78);
  border-bottom-color: rgb(62, 68, 78);
}

.crafting-input-slot:hover,
.crafting-input-slot:focus,
.crafting-input-slot--filled {
  color: rgb(238, 209, 153);
  background-color: rgb(35, 31, 24);
  border-left-color: rgb(174, 133, 67);
  border-right-color: rgb(174, 133, 67);
  border-top-color: rgb(174, 133, 67);
  border-bottom-color: rgb(174, 133, 67);
}

.crafting-input-slot.inventory-external-drop--valid {
  background-color: rgb(28, 49, 34);
  border-left-color: rgb(93, 175, 107);
  border-right-color: rgb(93, 175, 107);
  border-top-color: rgb(93, 175, 107);
  border-bottom-color: rgb(93, 175, 107);
}

.crafting-input-slot.inventory-external-drop--invalid {
  background-color: rgb(54, 27, 28);
  border-left-color: rgb(181, 75, 75);
  border-right-color: rgb(181, 75, 75);
  border-top-color: rgb(181, 75, 75);
  border-bottom-color: rgb(181, 75, 75);
}

.crafting-input-icon {
  position: absolute;
  left: 4px;
  right: 4px;
  top: 4px;
  bottom: 4px;
  width: auto;
  height: auto;
  -unity-background-scale-mode: scale-to-fit;
}

.crafting-input-name {
  position: absolute;
  left: 3px;
  right: 3px;
  bottom: 3px;
  min-height: 22px;
  padding-left: 2px;
  padding-right: 2px;
  white-space: normal;
  font-size: 10px;
  -unity-text-align: middle-center;
  color: rgb(225, 216, 195);
  background-color: rgba(10, 12, 16, 0.78);
}

.crafting-target-summary {
  flex-grow: 1;
  min-width: 0;
}

.crafting-slot-actions {
  min-height: 30px;
  margin-top: 3px;
  flex-direction: row;
  flex-wrap: wrap;
}

.crafting-slot-action {
  width: 48%;
  min-width: 0;
  min-height: 28px;
  margin-left: 1%;
  margin-right: 1%;
  padding: 3px 6px;
  white-space: normal;
  font-size: 10px;
}

.crafting-selected-rarity {
  min-height: 24px;
  white-space: normal;
  color: rgb(218, 193, 147);
  -unity-font-style: bold;
}

.crafting-summary-line {
  min-height: 20px;
  white-space: normal;
  color: rgb(178, 184, 193);
}

.crafting-rarity-actions,
.crafting-scope-actions,
.crafting-actions {
  flex-direction: row;
  flex-wrap: wrap;
}

.crafting-rarity-actions .item-context-action {
  width: 48%;
  margin-left: 1%;
  margin-right: 1%;
}

.crafting-scope {
  width: 31.33%;
  min-width: 0;
  min-height: 34px;
  margin-left: 1%;
  margin-right: 1%;
  white-space: normal;
  color: rgb(180, 185, 194);
  background-color: rgb(35, 39, 47);
  border-left-color: rgb(66, 72, 82);
  border-right-color: rgb(66, 72, 82);
  border-top-color: rgb(66, 72, 82);
  border-bottom-color: rgb(66, 72, 82);
}

.crafting-scope:hover,
.crafting-scope:focus,
.crafting-scope--selected {
  color: rgb(242, 214, 160);
  background-color: rgb(61, 49, 31);
  border-left-color: rgb(196, 151, 78);
  border-right-color: rgb(196, 151, 78);
  border-top-color: rgb(196, 151, 78);
  border-bottom-color: rgb(196, 151, 78);
}

.crafting-feedback {
  min-height: 48px;
  margin-top: 8px;
  padding: 7px;
  white-space: normal;
  color: rgb(155, 162, 174);
  background-color: rgb(20, 23, 29);
}

.crafting-actions .item-context-action {
  width: 48%;
  margin-left: 1%;
  margin-right: 1%;
}

.crafting-result {
  min-height: 58px;
  margin-top: 8px;
  padding: 8px;
  white-space: normal;
  color: rgb(153, 205, 158);
  background-color: rgb(23, 32, 28);
  border-left-width: 2px;
  border-left-color: rgb(75, 137, 85);
}
