<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:Style src="project://database/Assets/UI/Hud.uss?fileID=7433441132597879392&amp;guid=d225eb57055fd094795854125058bc2b&amp;type=3#Hud" />
  <ui:Style src="project://database/Assets/UI/GameMenu.uss?fileID=7433441132597879392&amp;guid=b4d4f2a63cd70ac488b7a48eb4b04c9e&amp;type=3#GameMenu" />
  <ui:Style src="project://database/Assets/UI/Inventory.uss?fileID=7433441132597879392&amp;guid=b18b5c9f65901f24c9fcc14f669c79e5&amp;type=3#Inventory" />
  <ui:Style src="project://database/Assets/UI/Shop.uss?fileID=7433441132597879392&amp;guid=fc59b910bf3e0bd488ca734ba8394fab&amp;type=3#Shop" />
  <ui:Style src="project://database/Assets/UI/Crafting.uss?fileID=7433441132597879392&amp;guid=a2906192d36f52048a633db31ced5424&amp;type=3#Crafting" />
  <ui:Style src="project://database/Assets/UI/ItemDetail.uss?fileID=7433441132597879392&amp;guid=e67c7a2d23b3a244d8a8ef35a84af7a0&amp;type=3#ItemDetail" />
  <ui:Template name="Hud" src="project://database/Assets/UI/Hud.uxml?fileID=9197481963319205126&amp;guid=15c85499aee872d4eb028c5b82b83699&amp;type=3#Hud" />
  <ui:Template name="Inventory" src="project://database/Assets/UI/Inventory.uxml?fileID=9197481963319205126&amp;guid=ab631162532b45f4ea91902aba703eb2&amp;type=3#Inventory" />
  <ui:Template name="Shop" src="project://database/Assets/UI/Shop.uxml?fileID=9197481963319205126&amp;guid=d13ce3c56db30db43bc3649e9d12d8a6&amp;type=3#Shop" />
  <ui:Template name="Crafting" src="project://database/Assets/UI/Crafting.uxml?fileID=9197481963319205126&amp;guid=123852e1d21f9bc4a8ccae84cfb7d656&amp;type=3#Crafting" />
  <ui:VisualElement name="game-ui-root" class="game-ui-root" picking-mode="Ignore">
    <ui:Instance template="Hud" />
    <ui:VisualElement name="game-menu-overlay" class="game-menu-overlay" picking-mode="Position">
      <ui:VisualElement name="game-menu-panel" class="game-menu-panel" picking-mode="Position">
        <ui:VisualElement class="game-menu-header">
          <ui:VisualElement class="game-menu-heading">
            <ui:Label text="营地整备" class="game-menu-title" />
            <ui:Label text="GAME MENU" class="game-menu-kicker" />
          </ui:VisualElement>
          <ui:VisualElement class="game-menu-tabs">
            <ui:Button name="game-menu-inventory-tab" text="背包" class="game-menu-tab" />
            <ui:Button name="game-menu-shop-tab" text="商店" class="game-menu-tab" />
            <ui:Button name="game-menu-crafting-tab" text="打造" class="game-menu-tab" />
          </ui:VisualElement>
          <ui:Button name="game-menu-close" text="关闭  Esc / B" class="game-menu-close" />
        </ui:VisualElement>
        <ui:VisualElement name="game-menu-content" class="game-menu-content">
          <ui:Instance template="Inventory" class="inventory-template" />
          <ui:Instance template="Shop" class="shop-template" />
          <ui:Instance template="Crafting" class="crafting-template" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
