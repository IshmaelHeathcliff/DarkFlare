.item-detail {
  flex-grow: 1;
  min-height: 190px;
}

.item-detail-header {
  min-height: 64px;
  margin-bottom: 8px;
  flex-direction: row;
  align-items: center;
}

.item-detail-icon {
  width: 56px;
  height: 56px;
  margin-right: 12px;
  background-color: rgb(17, 24, 33);
  -unity-background-scale-mode: scale-to-fit;
  border-left-width: 2px;
  border-right-width: 2px;
  border-top-width: 2px;
  border-bottom-width: 2px;
  border-left-color: rgb(122, 128, 139);
  border-right-color: rgb(122, 128, 139);
  border-top-color: rgb(122, 128, 139);
  border-bottom-color: rgb(122, 128, 139);
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
}


.item-detail-heading {
  flex-grow: 1;
}

.item-detail-name {
  min-height: 30px;
  white-space: normal;
  font-size: 21px;
  -unity-font-style: bold;
  color: rgb(231, 233, 236);
}

.item-detail-meta {
  min-height: 22px;
  white-space: normal;
  color: rgb(151, 160, 172);
}

.item-detail--magic .item-detail-name {
  color: rgb(156, 191, 255);
}

.item-detail--rare .item-detail-name {
  color: rgb(255, 226, 126);
}

.item-detail--unique .item-detail-name {
  color: rgb(255, 178, 91);
}

.item-detail-body {
  flex-grow: 1;
  min-height: 120px;
  padding-right: 6px;
}

.item-detail-group-title {
  min-height: 22px;
  margin-top: 8px;
  margin-bottom: 3px;
  padding-left: 7px;
  font-size: 12px;
  -unity-font-style: bold;
  color: rgb(195, 168, 120);
  border-left-width: 2px;
  border-left-color: rgb(132, 99, 52);
}

.item-detail-base,
.item-detail-modifier,
.item-detail-empty,
.item-detail-affix-name {
  min-height: 21px;
  padding-left: 9px;
  padding-right: 5px;
  white-space: normal;
}

.item-detail-base {
  color: rgb(181, 188, 199);
}

.item-detail-affix-name {
  min-height: 14px;
  margin-top: 0;
  padding-left: 9px;
  font-size: 9px;
  color: rgb(126, 134, 145);
}

.item-detail-modifier {
  color: rgb(137, 188, 163);
}

.item-detail-affix {
  margin-top: 3px;
  padding-top: 2px;
  padding-bottom: 2px;
  border-bottom-width: 1px;
  border-bottom-color: rgba(68, 73, 81, 0.55);
}

.item-detail-affix-content {
  min-height: 19px;
  padding-left: 9px;
  padding-right: 5px;
  white-space: normal;
  font-size: 12px;
  -unity-font-style: bold;
  color: rgb(151, 211, 178);
}

.item-detail--dense .item-detail-header {
  min-height: 54px;
  margin-bottom: 4px;
}

.item-detail--dense .item-detail-icon {
  width: 48px;
  height: 48px;
  margin-right: 10px;
}

.item-detail--dense .item-detail-name {
  min-height: 26px;
  font-size: 19px;
}

.item-detail--dense .item-detail-meta,
.item-detail--dense .item-detail-group-title {
  min-height: 18px;
}

.item-detail--dense .item-detail-group-title {
  margin-top: 4px;
  margin-bottom: 1px;
  font-size: 10px;
}

.item-detail--dense .item-detail-base,
.item-detail--dense .item-detail-modifier,
.item-detail--dense .item-detail-empty {
  min-height: 18px;
  font-size: 11px;
}

.item-detail--dense .item-detail-affix {
  margin-top: 1px;
  padding-top: 1px;
  padding-bottom: 1px;
}

.item-detail--dense .item-detail-affix-content {
  min-height: 17px;
  font-size: 11px;
}

.item-detail--dense .item-detail-affix-name {
  min-height: 12px;
  font-size: 8px;
}

.item-detail-empty {
  color: rgb(103, 111, 123);
  -unity-font-style: italic;
}
