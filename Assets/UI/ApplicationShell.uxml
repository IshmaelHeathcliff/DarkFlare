<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization" editor-extension-mode="False">
  <ui:Style src="project://database/Assets/UI/InputGlyphs.uss" />
  <ui:Style src="project://database/Assets/UI/Theme.uss" />
  <ui:Style src="project://database/Assets/UI/ApplicationShell.uss" />
  <ui:Style src="project://database/Assets/UI/Components.uss" />
  <ui:VisualElement name="application-shell" class="application-shell" picking-mode="Ignore">
    <ui:VisualElement name="application-front-end" class="application-layer application-front-end" picking-mode="Position">
      <ui:VisualElement class="front-end-vignette" picking-mode="Ignore" />
      <ui:VisualElement class="front-end-panel">
        <ui:Label name="front-end-brand" class="front-end-kicker" />
        <ui:Label class="front-end-title" text="">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="flow.front.title" />
          </Bindings>
        </ui:Label>
        <ui:Label class="front-end-subtitle" text="">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="flow.front.subtitle" />
          </Bindings>
        </ui:Label>
        <ui:VisualElement class="front-end-actions">
          <ui:Button name="front-end-continue" class="front-end-action front-end-action--primary" text="">
            <Bindings>
              <l:LocalizedString property="text" table="ui" entry="flow.front.continue" />
            </Bindings>
          </ui:Button>
          <ui:Button name="front-end-new-game" class="front-end-action" text="">
            <Bindings>
              <l:LocalizedString property="text" table="ui" entry="flow.front.new_game" />
            </Bindings>
          </ui:Button>
          <ui:Button name="front-end-settings" class="front-end-action" text="">
            <Bindings>
              <l:LocalizedString property="text" table="ui" entry="settings.open" />
            </Bindings>
          </ui:Button>
          <ui:DropdownField name="front-end-language" class="front-end-language" />
          <ui:VisualElement class="front-end-secondary-actions">
            <ui:Button name="front-end-delete-save" class="front-end-action front-end-action--quiet front-end-secondary-action--left" text="">
              <Bindings>
                <l:LocalizedString property="text" table="ui" entry="save.delete.action" />
              </Bindings>
            </ui:Button>
            <ui:Button name="front-end-quit" class="front-end-action front-end-action--quiet front-end-secondary-action--right" text="">
              <Bindings>
                <l:LocalizedString property="text" table="ui" entry="flow.front.quit" />
              </Bindings>
            </ui:Button>
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:Label name="front-end-version" class="front-end-version" />
    </ui:VisualElement>
    <ui:VisualElement name="application-settings" class="application-layer application-blocker application-settings" picking-mode="Position">
      <ui:VisualElement class="application-settings-panel">
        <ui:VisualElement class="application-settings-header">
          <ui:Label class="application-settings-title" text="">
            <Bindings>
              <l:LocalizedString property="text" table="ui" entry="settings.title" />
            </Bindings>
          </ui:Label>
          <ui:Button name="settings-back" class="application-settings-back" text="">
            <Bindings>
              <l:LocalizedString property="text" table="ui" entry="settings.back" />
            </Bindings>
          </ui:Button>
        </ui:VisualElement>
        <ui:ScrollView name="settings-scroll" class="application-settings-scroll">
          <ui:VisualElement class="application-settings-section">
            <ui:Label class="application-settings-section-title" text="">
              <Bindings>
                <l:LocalizedString property="text" table="ui" entry="settings.audio.title" />
              </Bindings>
            </ui:Label>
            <ui:Slider name="settings-master-volume" class="application-settings-slider" low-value="0" high-value="1" show-input-field="True" />
            <ui:Slider name="settings-music-volume" class="application-settings-slider" low-value="0" high-value="1" show-input-field="True" />
            <ui:Slider name="settings-sfx-volume" class="application-settings-slider" low-value="0" high-value="1" show-input-field="True" />
            <ui:Slider name="settings-ui-volume" class="application-settings-slider" low-value="0" high-value="1" show-input-field="True" />
            <ui:Toggle name="settings-muted" class="application-settings-toggle" />
          </ui:VisualElement>
          <ui:VisualElement class="application-settings-section">
            <ui:Label class="application-settings-section-title" text="">
              <Bindings>
                <l:LocalizedString property="text" table="ui" entry="settings.input.title" />
              </Bindings>
            </ui:Label>
            <ui:DropdownField name="settings-glyph-preference" class="application-settings-dropdown" />
            <ui:VisualElement name="settings-binding-list" class="application-settings-binding-list" />
            <ui:Button name="settings-restore-defaults" class="application-settings-restore" text="">
              <Bindings>
                <l:LocalizedString property="text" table="ui" entry="settings.restore.action" />
              </Bindings>
            </ui:Button>
          </ui:VisualElement>
          <ui:VisualElement class="application-settings-section">
            <ui:Label class="application-settings-section-title" text="">
              <Bindings>
                <l:LocalizedString property="text" table="ui" entry="settings.accessibility.title" />
              </Bindings>
            </ui:Label>
            <ui:Toggle name="settings-reduce-motion" class="application-settings-toggle" />
          </ui:VisualElement>
        </ui:ScrollView>
        <ui:Label name="settings-status" class="application-settings-status" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="application-toast" class="application-layer application-toast" picking-mode="Ignore">
      <ui:Label name="application-toast-message" class="application-toast-message" />
    </ui:VisualElement>
    <ui:VisualElement name="application-modal" class="application-layer application-blocker application-modal" picking-mode="Position">
      <ui:VisualElement class="application-dialog">
        <ui:Label name="application-modal-title" class="application-dialog-title" />
        <ui:Label name="application-modal-message" class="application-dialog-message" />
        <ui:VisualElement class="application-dialog-actions">
          <ui:Button name="application-modal-retry" class="application-dialog-action application-dialog-action--primary" />
          <ui:Button name="application-modal-cancel" class="application-dialog-action" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="application-busy" class="application-layer application-blocker application-busy" picking-mode="Position">
      <ui:VisualElement class="application-busy-card">
        <ui:Label name="application-busy-label" class="application-busy-label" />
        <ui:ProgressBar name="application-busy-progress" class="application-busy-progress" low-value="0" high-value="100" value="0" />
        <ui:Button name="application-busy-cancel" class="application-busy-cancel" text="">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="flow.modal.cancel" />
          </Bindings>
        </ui:Button>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="application-fatal" class="application-layer application-blocker application-fatal" picking-mode="Position">
      <ui:VisualElement class="application-dialog application-dialog--fatal">
        <ui:Label class="application-dialog-title" text="">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="flow.fatal.title" />
          </Bindings>
        </ui:Label>
        <ui:Label name="application-fatal-message" class="application-dialog-message" />
        <ui:Button name="application-fatal-quit" class="application-dialog-action application-dialog-action--primary" text="">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="flow.front.quit" />
          </Bindings>
        </ui:Button>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
