<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:VisualElement name="crafting-page" class="crafting-page item-context-panel ui-panel-frame" picking-mode="Position">
    <ui:VisualElement class="item-context-header">
      <ui:Label text="打造" class="item-context-title" />
      <ui:Label text="FORGE" class="item-context-kicker" />
    </ui:VisualElement>
    <ui:Label name="crafting-gold" text="持有金币  0" class="crafting-gold" />
    <ui:Label name="crafting-selected-capacity" text="词缀容量：-" class="crafting-summary-line" />
    <ui:Label name="crafting-selected-value" text="当前价值：-" class="crafting-summary-line" />
    <ui:Label text="当前词缀" class="item-context-subtitle" />
    <ui:ScrollView name="crafting-affix-scroll" class="crafting-affix-scroll" mode="Vertical">
      <ui:VisualElement name="crafting-affix-list" class="crafting-affix-list" />
    </ui:ScrollView>
    <ui:Label name="crafting-affix-empty" text="当前物品没有词缀" class="crafting-empty" />
    <ui:Label name="crafting-selected-affix" text="选中词缀：-" class="crafting-selected-affix" />
    <ui:Label name="crafting-selected-affix-detail" text="词缀详情：-" class="crafting-selected-affix-detail" />
    <ui:Label name="crafting-feedback" text="从玩家背包选择要打造的物品" class="crafting-feedback" />
    <ui:VisualElement name="crafting-actions" class="crafting-actions">
      <ui:Button name="crafting-add-affix" text="添加词缀" class="item-context-action item-context-action--primary" />
      <ui:Button name="crafting-reroll-all" text="重随全部" class="item-context-action" />
      <ui:Button name="crafting-remove-reroll" text="移除并重随" class="item-context-action" />
      <ui:Button name="crafting-upgrade-affix" text="提升数值" class="item-context-action" />
    </ui:VisualElement>
    <ui:Label text="拖放不会触发打造；所有操作需明确确认" class="item-context-help" />
  </ui:VisualElement>
</ui:UXML>
