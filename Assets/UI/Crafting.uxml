<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization" editor-extension-mode="False">
  <ui:VisualElement name="crafting-page" class="crafting-page item-context-panel ui-panel-frame" picking-mode="Position">
    <ui:VisualElement class="item-context-header">
      <ui:Label text="" class="item-context-title">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="crafting.title" />
        </Bindings>
      </ui:Label>
      <ui:Label text="" class="item-context-kicker">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="crafting.kicker" />
        </Bindings>
      </ui:Label>
    </ui:VisualElement>
    <ui:Label name="crafting-gold" text="" class="crafting-gold" />
    <ui:VisualElement class="crafting-selection-card">
      <ui:Button name="crafting-input-slot" class="crafting-input-slot">
        <ui:VisualElement name="crafting-input-icon" class="crafting-input-icon" picking-mode="Ignore" />
        <ui:Label name="crafting-input-name" text="" class="crafting-input-name" picking-mode="Ignore" />
      </ui:Button>
      <ui:VisualElement class="crafting-target-summary">
        <ui:Label name="crafting-selected-rarity" text="" class="crafting-selected-rarity" />
        <ui:Label name="crafting-selected-capacity" text="" class="crafting-summary-line" />
        <ui:Label name="crafting-selected-value" text="" class="crafting-summary-line" />
        <ui:VisualElement class="crafting-slot-actions">
          <ui:Button name="crafting-slot-place" text="" class="crafting-slot-action" />
          <ui:Button name="crafting-slot-remove" text="" class="crafting-slot-action">
            <Bindings>
              <l:LocalizedString property="text" table="ui" entry="crafting.action.return" />
            </Bindings>
          </ui:Button>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label text="" class="item-context-subtitle">
      <Bindings>
        <l:LocalizedString property="text" table="ui" entry="crafting.rarity.title" />
      </Bindings>
    </ui:Label>
    <ui:VisualElement class="crafting-rarity-actions">
      <ui:Button name="crafting-upgrade-rarity" text="" class="item-context-action item-context-action--primary" />
      <ui:Button name="crafting-reset-normal" text="" class="item-context-action" />
    </ui:VisualElement>
    <ui:Label text="" class="item-context-subtitle">
      <Bindings>
        <l:LocalizedString property="text" table="ui" entry="crafting.scope.title" />
      </Bindings>
    </ui:Label>
    <ui:VisualElement class="crafting-scope-actions">
      <ui:Button name="crafting-scope-any" text="" class="crafting-scope">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="crafting.scope.any" />
        </Bindings>
      </ui:Button>
      <ui:Button name="crafting-scope-prefix" text="" class="crafting-scope">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="crafting.scope.prefix" />
        </Bindings>
      </ui:Button>
      <ui:Button name="crafting-scope-suffix" text="" class="crafting-scope">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="crafting.scope.suffix" />
        </Bindings>
      </ui:Button>
    </ui:VisualElement>
    <ui:Label name="crafting-feedback" text="" class="crafting-feedback" />
    <ui:VisualElement name="crafting-actions" class="crafting-actions">
      <ui:Button name="crafting-reroll-affixes" text="" class="item-context-action" />
      <ui:Button name="crafting-add-affix" text="" class="item-context-action" />
      <ui:Button name="crafting-remove-affix" text="" class="item-context-action" />
      <ui:Button name="crafting-reroll-values" text="" class="item-context-action" />
    </ui:VisualElement>
    <ui:Label name="crafting-result" text="" class="crafting-result" />
    <ui:Label text="" class="item-context-help">
      <Bindings>
        <l:LocalizedString property="text" table="ui" entry="crafting.help.random" />
      </Bindings>
    </ui:Label>
  </ui:VisualElement>
</ui:UXML>
