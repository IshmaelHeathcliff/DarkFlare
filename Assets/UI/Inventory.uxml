<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization" editor-extension-mode="False">
  <ui:VisualElement name="inventory-page" class="inventory-page item-context-panel ui-panel-frame" picking-mode="Position">
    <ui:VisualElement class="item-context-header">
      <ui:Label text="" class="item-context-title">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="inventory.stats.title" />
        </Bindings>
      </ui:Label>
      <ui:Label text="" class="item-context-kicker">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="inventory.stats.kicker" />
        </Bindings>
      </ui:Label>
    </ui:VisualElement>
    <ui:VisualElement name="inventory-attribute-card" class="inventory-attribute-card">
      <ui:VisualElement name="inventory-attribute-grid" class="inventory-attribute-grid" />
    </ui:VisualElement>
    <ui:Label text="" class="item-context-subtitle">
      <Bindings>
        <l:LocalizedString property="text" table="ui" entry="inventory.actions.title" />
      </Bindings>
    </ui:Label>
    <ui:Label name="inventory-target-slot" text="" class="inventory-target-slot" />
    <ui:Label name="inventory-feedback" text="" class="inventory-feedback" />
    <ui:VisualElement name="inventory-actions" class="inventory-actions">
      <ui:Button name="inventory-equip" text="" class="item-context-action item-context-action--primary inventory-equip">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="inventory.equip.action" />
        </Bindings>
      </ui:Button>
      <ui:Button name="inventory-unequip" text="" class="item-context-action inventory-unequip">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="inventory.unequip.action" />
        </Bindings>
      </ui:Button>
    </ui:VisualElement>
    <ui:Label text="" class="item-context-help">
      <Bindings>
        <l:LocalizedString property="text" table="ui" entry="inventory.help.drag" />
      </Bindings>
    </ui:Label>
  </ui:VisualElement>
</ui:UXML>
