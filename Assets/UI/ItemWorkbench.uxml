<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization" editor-extension-mode="False">
  <ui:VisualElement name="item-workbench-shared" class="item-workbench-shared" picking-mode="Position">
    <ui:VisualElement name="inventory-equipment" class="item-workbench-equipment ui-panel-frame">
      <ui:VisualElement class="item-workbench-section-header">
        <ui:Label text="" class="item-workbench-section-title">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="workbench.equipment.title" />
          </Bindings>
        </ui:Label>
        <ui:Label text="" class="item-workbench-section-kicker">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="workbench.equipment.kicker" />
          </Bindings>
        </ui:Label>
      </ui:VisualElement>
      <ui:VisualElement class="equipment-canvas">
        <ui:VisualElement class="equipment-silhouette" picking-mode="Ignore">
          <ui:VisualElement class="equipment-silhouette-head" />
          <ui:VisualElement class="equipment-silhouette-body" />
        </ui:VisualElement>
        <ui:VisualElement class="equipment-slot-layout">
          <ui:Button name="inventory-slot-weapon" text="" class="inventory-equipment-slot equipment-slot--weapon" />
          <ui:Button name="inventory-slot-armor" text="" class="inventory-equipment-slot equipment-slot--armor" />
          <ui:Button name="inventory-slot-ring-left" text="" class="inventory-equipment-slot equipment-slot--ring-left" />
          <ui:Button name="inventory-slot-ring-right" text="" class="inventory-equipment-slot equipment-slot--ring-right" />
          <ui:VisualElement name="equipment-future-slots" class="equipment-future-slots" picking-mode="Ignore">
            <ui:Label text="" class="equipment-future-title">
              <Bindings>
                <l:LocalizedString property="text" table="ui" entry="equipment.future.title" />
              </Bindings>
            </ui:Label>
            <ui:VisualElement class="equipment-future-slot-row">
              <ui:VisualElement class="equipment-future-slot" />
              <ui:VisualElement class="equipment-future-slot" />
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:Label text="" class="item-workbench-help">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="workbench.equipment.help" />
        </Bindings>
      </ui:Label>
    </ui:VisualElement>
    <ui:VisualElement class="item-workbench-inventory ui-panel-frame">
      <ui:VisualElement class="item-workbench-section-header">
        <ui:Label text="" class="item-workbench-section-title">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="workbench.inventory.title" />
          </Bindings>
        </ui:Label>
        <ui:Label text="" class="item-workbench-section-kicker">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="workbench.inventory.size" />
          </Bindings>
        </ui:Label>
      </ui:VisualElement>
      <ui:VisualElement name="inventory-grid-frame" class="inventory-grid-frame">
        <ui:VisualElement name="inventory-grid" class="inventory-grid" picking-mode="Position" />
        <ui:Label name="inventory-empty" text="" class="inventory-empty" picking-mode="Ignore">
          <Bindings>
            <l:LocalizedString property="text" table="ui" entry="workbench.inventory.empty" />
          </Bindings>
        </ui:Label>
      </ui:VisualElement>
      <ui:Label text="" class="item-workbench-help">
        <Bindings>
          <l:LocalizedString property="text" table="ui" entry="workbench.inventory.help" />
        </Bindings>
      </ui:Label>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
