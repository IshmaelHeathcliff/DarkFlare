.shop-gold {
  min-height: 34px;
  margin-bottom: 8px;
  padding: 7px;
  color: rgb(244, 210, 124);
  background-color: rgb(34, 31, 24);
  -unity-font-style: bold;
}

.shop-merchant-frame {
  position: relative;
  flex-grow: 1;
  min-height: 328px;
  margin-bottom: 8px;
  padding: 9px;
  align-items: center;
  justify-content: center;
  background-color: rgba(8, 10, 14, 0.5);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(47, 49, 54);
  border-right-color: rgb(47, 49, 54);
  border-top-color: rgb(47, 49, 54);
  border-bottom-color: rgb(47, 49, 54);
}

.shop-merchant-grid {
  position: relative;
}

.shop-grid-cell {
  position: absolute;
  background-color: rgb(20, 25, 32);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(52, 56, 63);
  border-right-color: rgb(52, 56, 63);
  border-top-color: rgb(52, 56, 63);
  border-bottom-color: rgb(52, 56, 63);
}

.shop-item {
  position: absolute;
  padding: 4px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgb(24, 29, 36);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-color: rgb(91, 94, 101);
  border-right-color: rgb(91, 94, 101);
  border-top-color: rgb(91, 94, 101);
  border-bottom-color: rgb(91, 94, 101);
}

.shop-item:hover,
.shop-item:focus,
.shop-item--selected {
  background-color: rgb(55, 45, 32);
  border-left-width: 2px;
  border-right-width: 2px;
  border-top-width: 2px;
  border-bottom-width: 2px;
  border-left-color: rgb(208, 164, 88);
  border-right-color: rgb(208, 164, 88);
  border-top-color: rgb(208, 164, 88);
  border-bottom-color: rgb(208, 164, 88);
}

.shop-item-icon {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 26px;
  min-height: 26px;
  width: 100%;
  height: 100%;
  margin-right: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.shop-item--magic {
  border-left-color: rgb(82, 127, 209);
}

.shop-item--rare {
  border-left-color: rgb(204, 167, 58);
}

.shop-item--unique {
  border-left-color: rgb(205, 105, 42);
}

.shop-empty {
  position: absolute;
  color: rgb(105, 111, 123);
  font-size: 17px;
  -unity-font-style: italic;
}

.shop-selection-summary {
  min-height: 30px;
  flex-direction: row;
  align-items: center;
}

.shop-detail-line,
.shop-price {
  flex-grow: 1;
  min-height: 28px;
  padding: 5px;
  white-space: normal;
  color: rgb(177, 182, 191);
}

.shop-price {
  color: rgb(225, 196, 129);
}

.shop-feedback {
  min-height: 54px;
  margin-top: 4px;
  white-space: normal;
  color: rgb(155, 162, 174);
}

.shop-actions {
  flex-direction: row;
}

.shop-actions .item-context-action {
  flex-grow: 1;
}

.shop-actions .shop-buy {
  margin-right: 6px;
}

.game-menu-panel--compact .shop-merchant-frame {
  min-height: 318px;
  padding: 4px;
}

.game-menu-panel--compact .shop-feedback {
  min-height: 34px;
}

.game-menu-panel--compact .shop-page .item-context-help {
  display: none;
}
