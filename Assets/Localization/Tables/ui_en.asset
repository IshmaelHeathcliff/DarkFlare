    m_Metadata:
      m_Items:
      - rid: 6738608143192817845
  - m_Id: 7191908215414790
    m_Localized: "Mana recovery = maximum mana \xD7 5%/s + nonnegative flat bonus. Full resources stop increasing. Pause, death or inactivity stops recovery without changing its capacity."
