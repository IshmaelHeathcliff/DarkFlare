    m_Localized: "\u751F\u547D {0} / {1}\uFF08{2}%\uFF09\n\u6CD5\u529B {3} / {4}\uFF08{5}%\uFF09\n\u6062\u590D\u80FD\u529B\uFF1A\u751F\u547D {6}/\u79D2 \xB7 \u6CD5\u529B {7}/\u79D2\n\u5F53\u524D\u72B6\u6001\uFF1A{8}"
