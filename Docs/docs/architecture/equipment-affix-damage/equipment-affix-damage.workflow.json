  "cards": [
    {
      "dot": "cyan",
      "title": "LocalItem 的实际时机",
      "items": [
        "武器局部词条在发射时加入快照，和全局词条共走伤害管线。",
        "换装只影响后续攻击；目标属性在碰撞时读取。"
      ]
    },
    {
      "dot": "emerald",
      "title": "两条数值路径",
      "items": [
        "非伤害 GlobalActor 在换装时聚合；伤害词条逐包结算。",
        "来源 Increase 加算、More 连乘；目标 Increase / More 均连乘。"
      ]
    },
    {
      "dot": "amber",
      "title": "边界与后续响应",
      "items": [
        "武器来源技能无武器则拒绝发射；技能来源使用自身基础伤害。",
        "存活目标可附加命中状态；周期伤害另走无命中、无暴击路径。"
      ]
    }
